{
  "name": "temhoa-desktop",
  "version": "1.1.1",
  "description": "TEMhoa Minh Dien - thiet ke tem hoa",
  "author": "Minh Dien",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "test:desktop": "node smoke.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "vn.minhdien.temhoa",
    "productName": "TEMhoa",
    "asar": true,
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../TemHoa-MinhDien.html",
        "to": "app/TemHoa-MinhDien.html"
      },
      {
        "from": "../professional-ui.css",
        "to": "app/professional-ui.css"
      },
      {
        "from": "../Mo-TemHoa-Windows.ps1",
        "to": "app/Mo-TemHoa-Windows.ps1"
      },
      {
        "from": "../Background-TemHoa-Windows.ps1",
        "to": "app/Background-TemHoa-Windows.ps1"
      },
      {
        "from": "../Print-TemHoa-Windows.ps1",
        "to": "app/Print-TemHoa-Windows.ps1"
      },
      {
        "from": "../Mau-Tem-Hoa",
        "to": "app/Mau-Tem-Hoa"
      },
      {
        "from": "../build-ai/temhoa-ai",
        "to": "ai"
      },
      {
        "from": "../build-models",
        "to": "models"
      },
      {
        "from": "../assets",
        "to": "app/assets"
      },
      {
        "from": "../studio.css",
        "to": "app/studio.css"
      },
      {
        "from": "../studio-core.js",
        "to": "app/studio-core.js"
      },
      {
        "from": "../studio.js",
        "to": "app/studio.js"
      },
      {
        "from": "../studio-objects.js",
        "to": "app/studio-objects.js"
      },
      {
        "from": "../image-tools.js",
        "to": "app/image-tools.js"
      },
      {
        "from": "../image-tools.css",
        "to": "app/image-tools.css"
      },
      {
        "from": "../clipboard-tools.js",
        "to": "app/clipboard-tools.js"
      },
      {
        "from": "../shape-tools.js",
        "to": "app/shape-tools.js"
      },
      {
        "from": "../color-tools.js",
        "to": "app/color-tools.js"
      },
      {
        "from": "../editor-core.js",
        "to": "app/editor-core.js"
      },
      {
        "from": "../editor-render.js",
        "to": "app/editor-render.js"
      },
      {
        "from": "../editor-objects.js",
        "to": "app/editor-objects.js"
      },
      {
        "from": "../editor-documents.js",
        "to": "app/editor-documents.js"
      },
      {
        "from": "../editor-shell.js",
        "to": "app/editor-shell.js"
      },
      {
        "from": "../editor-topbar.js",
        "to": "app/editor-topbar.js"
      },
      {
        "from": "../editor-actions.js",
        "to": "app/editor-actions.js"
      },
      {
        "from": "../editor-text-transform.js",
        "to": "app/editor-text-transform.js"
      },
      {
        "from": "../editor-performance.js",
        "to": "app/editor-performance.js"
      },
      {
        "from": "../editor-selection-tools.js",
        "to": "app/editor-selection-tools.js"
      },
      {
        "from": "../editor-precise-selection.js",
        "to": "app/editor-precise-selection.js"
      },
      {
        "from": "../editor-canvas-interactions.js",
        "to": "app/editor-canvas-interactions.js"
      },
      {
        "from": "../editor-layer-scroll.js",
        "to": "app/editor-layer-scroll.js"
      },
      {
        "from": "../editor-font-size.js",
        "to": "app/editor-font-size.js"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TEMhoa-Setup-${version}-${arch}.exe",
      "icon": "../assets/temhoa.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TEMhoa",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "../release"
    }
  }
}
